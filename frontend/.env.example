# Copy this file to .env and fill in values after deploying contracts to testnet.
# Never commit .env to version control.

VITE_NETWORK=testnet

# Backend REST API origin, baked in at build time.
#
# Local development: the Vite dev server serves the app on :5173 and has no API
# proxy, so point this at the backend directly (this is also the fallback when
# the variable is unset).
#
# Containerised (docker compose): leave it EMPTY. An empty value makes the app
# call the API on its own origin and nginx proxies /api/ to the `backend`
# service — see frontend/nginx.conf and docker-compose.yml. The Dockerfile sets
# this default itself, so compose does not need this file.
VITE_API_URL=http://localhost:3000

# Deployed Soroban contract IDs (run `stellar contract deploy` to get these)
VITE_ESCROW_CONTRACT_ID=
VITE_DISPUTE_CONTRACT_ID=
VITE_REPUTATION_CONTRACT_ID=

# USDC on Stellar testnet (Circle's testnet USDC asset contract)
VITE_USDC_CONTRACT_ID=

# Stellar Asset Contract for native XLM (used if a job pays in XLM)
VITE_XLM_CONTRACT_ID=
