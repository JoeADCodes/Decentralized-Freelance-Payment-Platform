// Prisma schema for Stellar Freelance Payment Platform
// Run: prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users — identified by their Stellar public key (G...)
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  stellarAddress String @unique
  displayName  String?
  bio          String?
  createdAt    DateTime @default(now())

  jobsAsClient     Job[]      @relation("ClientJobs")
  jobsAsFreelancer Job[]      @relation("FreelancerJobs")
  ratingsGiven     Rating[]   @relation("RatingsGiven")
  ratingsReceived  Rating[]   @relation("RatingsReceived")
}

// ---------------------------------------------------------------------------
// Jobs — mirrors on-chain escrow, enriched with off-chain metadata
// ---------------------------------------------------------------------------
model Job {
  id              String    @id @default(cuid())
  /// On-chain escrow ID returned by escrow.create()
  escrowId        BigInt?   @unique
  title           String
  description     String
  status          JobStatus @default(CREATED)
  /// Asset symbol the job pays in (see lib/assets.ts)
  asset           String    @default("USDC")

  clientId        String
  client          User      @relation("ClientJobs", fields: [clientId], references: [id])

  freelancerId    String?
  freelancer      User?     @relation("FreelancerJobs", fields: [freelancerId], references: [id])

  totalAmountUsdc Decimal
  milestones      Milestone[]
  disputes        Dispute[]
  ratings         Rating[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  // GET /api/jobs: `WHERE status = ? ORDER BY createdAt DESC LIMIT/OFFSET`.
  // A composite index serves filter + ordering in one range scan (issue #92).
  @@index([status, createdAt])
  // GET /api/jobs?client=… / ?freelancer=… join through these FKs, and
  // GET /api/users/:address counts jobsAsClient / jobsAsFreelancer by them.
  @@index([clientId])
  @@index([freelancerId])
}

enum JobStatus {
  CREATED
  FUNDED
  ACTIVE
  COMPLETED
  DISPUTED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Milestones
// ---------------------------------------------------------------------------
model Milestone {
  id          String          @id @default(cuid())
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id])
  index       Int
  amountUsdc  Decimal
  description String?
  status      MilestoneStatus @default(PENDING)
  deadline    DateTime?
  releasedAt  DateTime?

  // Every `include: { milestones: true }` (job list/detail, escrow routes,
  // indexer milestone-release handling) joins on jobId.
  @@index([jobId])
}

enum MilestoneStatus {
  PENDING
  RELEASED
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------
model Dispute {
  id               String        @id @default(cuid())
  /// On-chain dispute ID from dispute contract
  onChainId        BigInt?       @unique
  /// One dispute per job, which is the invariant the contracts already enforce:
  /// `dispute.raise` stores `EscrowDispute(escrow_id)` and returns
  /// `AlreadyRaised` for a second raise, and a job has exactly one escrow.
  ///
  /// Unique rather than merely indexed because the row is written twice by two
  /// different writers: `POST /api/disputes` creates it (with the reason, since
  /// the `Raised` event carries none) before an on-chain id exists, and the
  /// indexer's `raised` handler / `POST /:id/sync` attach the id afterwards.
  /// Keying that second write on the job instead of on the id is what keeps a
  /// disputed job from ending up with two rows — the bug fixed in #86. It is
  /// also the unique key the indexer upserts on.
  jobId            String        @unique
  job              Job           @relation(fields: [jobId], references: [id])
  raisedByAddress  String
  reason           String
  status           DisputeStatus @default(RAISED)
  clientShare      Decimal?
  freelancerShare  Decimal?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())

  // No @@index([jobId]): GET /api/jobs/:id `include: { disputes: true }` and the
  // indexer's `dispute.updateMany({ where: { job: { escrowId } } })` both read by
  // jobId, and the unique constraint above is that index.
}

enum DisputeStatus {
  RAISED
  UNDER_REVIEW
  /// A panel ruled and the escrow was resolved with a split.
  RESOLVED
  /// The escrow was refunded (expiry or dispute timelock) with no ruling.
  /// Terminal: a refunded dispute is no longer open.
  REFUNDED
}

// ---------------------------------------------------------------------------
// Ratings — mirrors on-chain reputation contract
// ---------------------------------------------------------------------------
model Rating {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  raterId    String
  rater      User     @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId    String
  ratee      User     @relation("RatingsReceived", fields: [rateeId], references: [id])
  score      Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  // GET /api/jobs/:id `include: { ratings: true }` joins on jobId.
  @@index([jobId])
  // GET /api/reputation/:address aggregates `WHERE rateeId = ?` (via stellarAddress).
  @@index([rateeId])
  // Ratings submitted by a rater (issue #92; also the prefix of the unique below).
  @@index([raterId])

  @@unique([raterId, jobId])
}

// ---------------------------------------------------------------------------
// IndexerCursor — tracks last processed Horizon ledger per event type
// ---------------------------------------------------------------------------
model IndexerCursor {
  id          String   @id
  lastLedger  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// IndexerDeadLetter — contract events the indexer could not apply
//
// A failing event never blocks the batch (the cursor still advances), so
// without this table a decode/persist bug would silently drop state changes.
// Rows are kept for inspection and replayed by hand after a fix.
// ---------------------------------------------------------------------------
model IndexerDeadLetter {
  /// Event id from Soroban RPC (stable across re-fetches of the same event)
  id          String   @id
  ledger      Int
  eventName   String?
  contractId  String?
  error       String
  /// Incremented when the same event is recorded again (e.g. after a cursor rewind)
  attempts    Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Notification — per-user feed of indexed escrow and dispute events (issue #66)
//
// State changes were only visible by reloading a job page, so "did my client
// fund yet?" meant watching the chain by hand. The indexer now writes one row
// per participant per event, which makes the feed persistent: it survives a
// restart and does not depend on a client having been open when the event
// happened.
// ---------------------------------------------------------------------------
model Notification {
  /// Deterministic key `<event id>:<address>`, so an event replayed after a
  /// cursor rewind upserts instead of duplicating the feed.
  id        String   @id
  /// Recipient: the Stellar address the notification is for.
  address   String
  /// Indexed event name (`funded`, `milestone_released`, …) — docs/EVENTS.md.
  /// Kept alongside the rendered title so the feed can be filtered or reworded
  /// later without re-deriving the event.
  type      String
  title     String
  body      String?
  /// Escrow the event belongs to, and the off-chain job when one exists, so the
  /// feed can link straight to the job it is about.
  escrowId  BigInt?
  jobId     String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  // The feed query is "this address's notifications, newest first".
  @@index([address, createdAt])
}

// ---------------------------------------------------------------------------
// AuthNonce — single-use, short-lived challenge nonces for wallet auth
// ---------------------------------------------------------------------------
model AuthNonce {
  /// Stellar address the nonce was issued to
  address   String   @id
  nonce     String
  expiresAt DateTime
}
